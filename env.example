# ─────────────────────────────────────────────────────────────
# NSE Camarilla Scanner — Environment Config
# Copy this file to .env and fill in your credentials
# ─────────────────────────────────────────────────────────────

# ── SCANNER SETTINGS ──────────────────────────────────────────
VOL_DAYS=10          # Volume average window (5, 10, 20, 30, 50)
VOL_MULT=2.0         # Min volume spike multiplier (1.5, 2.0, 2.5, 3.0)
MIN_SCORE=55         # Minimum score to include (0–100)
SCAN_INTERVAL=300    # Seconds between scans in continuous mode

# ── EMA FILTERS (true = must be above this EMA) ───────────────
EMA_10=true
EMA_20=true
EMA_50=true
EMA_200=true

# ── TELEGRAM ALERTS ───────────────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot → copy token below
# 2. Add bot to your group or get your chat ID via @userinfobot
TG_TOKEN=YOUR_BOT_TOKEN_HERE
TG_CHAT_ID=YOUR_CHAT_ID_HERE     # e.g. -1001234567890 for group

# ── WHATSAPP ALERTS (via Twilio) ──────────────────────────────
# 1. Sign up free at twilio.com
# 2. Enable WhatsApp Sandbox in Twilio console
# 3. Fill in Account SID, Auth Token, and your WhatsApp number
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token_here
TWILIO_FROM=whatsapp:+14155238886   # Twilio sandbox number (keep this)
TWILIO_TO=whatsapp:+919876543210    # YOUR WhatsApp number with country code
